# NAE25 environment config — copy to .env and fill in values

# Strava API credentials (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Shared OAuth token file (default shown — matches the Strava MCP server)
# No STRAVA_REFRESH_TOKEN needed; the token file is managed automatically.
STRAVA_TOKEN_FILE=~/.strava_mcp_token.json
